{
  "name": "@jonaskahn/specmine",
  "version": "0.1.0",
  "description": "Mine product specifications (JSON) from text content or PDF files using an LLM.",
  "license": "MIT",
  "author": "jonaskahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonaskahn/specmine.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mjs,cjs}\"",
    "test": "tsx --test test/*.test.ts",
    "coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "integrate-test": "tsx integrate-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.12.0",
    "tinyld": "^1.3.4"
  }
}
