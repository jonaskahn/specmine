{
  "name": "@jonaskahn/specmine",
  "version": "0.3.1",
  "description": "Mine product specifications (JSON) from text content or PDF files using an LLM.",
  "license": "MIT",
  "author": "jonaskahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonaskahn/specmine.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "pino": ">=9",
    "winston": ">=3"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mjs,cjs}\"",
    "test": "SPECMINE_LOG_LEVEL=silent tsx --test test/*.test.ts",
    "coverage": "SPECMINE_LOG_LEVEL=silent c8 --include src --reporter=text --check-coverage --statements 100 --branches 100 --functions 100 --lines 100 node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino": "^10.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.12.0",
    "tinyld": "^1.3.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
