# Copy to .env and fill in the values you need.
# Settings resolve as: explicit options -> env vars below -> built-in defaults.
# See README.md "Providers" and "Retry and circuit breaker" for details.

# Native fallbacks, used only if SPECMINE_LLM_API_KEY is unset.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Preferred: works for both createOpenAiProvider() and createAnthropicProvider().
SPECMINE_LLM_API_KEY=

# Override the API base URL and model for both providers, e.g. to point at a
# LiteLLM proxy, Azure, Ollama, OpenRouter, Groq, or another compatible host.
# SPECMINE_LLM_API_HOST=https://litellm.example.com/v1
# SPECMINE_LLM_MODEL=gpt-5.6-luna

# Retry and circuit breaker (createResilientProvider), all optional.
SPECMINE_LLM_MAX_RETRIES=2
SPECMINE_LLM_BACKOFF_MS=200
SPECMINE_LLM_FAILURE_THRESHOLD=5
SPECMINE_LLM_COOLDOWN_MS=30000

# Logging. Level: SPECMINE_LOG_LEVEL or global LOG_LEVEL (default: warn).
# Values: silent|fatal|error|warn|info|debug|trace
SPECMINE_LOG_LEVEL=info
# Driver: pino | winston | auto — auto picks whichever is installed (default: auto).
# SPECMINE_LOG_DRIVER=auto
# Advanced: swap the underlying logger module (defaults: pino / winston).
# SPECMINE_LOG_PINO_MODULE=pino
# SPECMINE_LOG_WINSTON_MODULE=winston
